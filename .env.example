# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- required

# The subscription's signing secret (whsec_...), shown once when the
# subscription is created or its secret rotated.
WEBHOOK_SECRET=whsec_xxx

# Optional: the old secret, for the 24 hours after a rotation.
WEBHOOK_SECRET_PREVIOUS=

# ------------------------------------------------- replay / snapshot (optional)

# Without these the receiver still verifies and records every event; it just
# logs a gap instead of requesting a replay.
LIQBEACON_API_URL=https://api.liqbeacon.com
LIQBEACON_API_KEY=
# Load this subscription's watched outputs on first run, then resume events
# right after the snapshot.
LIQBEACON_SUBSCRIPTION_ID=

# ------------------------------------------------------------------ server

# nginx terminates TLS and proxies to this address. Keep it on loopback.
HOST=127.0.0.1
PORT=3000
WEBHOOK_PATH=/webhooks/cardano

# cursors.json and received.ndjson live here.
DATA_DIR=./data

# Protects GET /status. Empty: /status is open.
STATUS_TOKEN=

# ------------------------------------------------------- fault injection

# Answer this fraction of real (non-test) events with 500, to watch the
# platform retry them in order. 0 disables it; 0.3 fails about one in three.
SIMULATE_FAILURE_RATE=0

# Wait this long before answering, to watch the platform's timeout
# (DELIVERY_TIMEOUT_MS, 10 s by default). 0 disables it.
SIMULATE_DELAY_MS=0
